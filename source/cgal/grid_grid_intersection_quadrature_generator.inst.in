for (dim : SPACE_DIMENSIONS)
  {
#if dim == 2 || dim == 3

    template class GridGridIntersectionQuadratureGenerator<dim>;

    template void
    GridGridIntersectionQuadratureGenerator<dim>::setup_domain_boundary(
      const Triangulation<dim> &);

    template void GridGridIntersectionQuadratureGenerator<dim>::reclassify(
      const Triangulation<dim> &);
    template void
    GridGridIntersectionQuadratureGenerator<dim>::partition_surface_mesh(
      const Triangulation<dim> &);

    template void
    GridGridIntersectionQuadratureGenerator<dim>::setup_domain_boundary(
      const parallel::distributed::Triangulation<dim> &);

    template void GridGridIntersectionQuadratureGenerator<dim>::reclassify(
      const parallel::distributed::Triangulation<dim> &);

    template void
    GridGridIntersectionQuadratureGenerator<dim>::partition_surface_mesh(
      const parallel::distributed::Triangulation<dim> &);

#endif
  }
